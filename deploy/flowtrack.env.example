FT_CH_URL=http://127.0.0.1:8123
FT_CH_USER=flowtrack
FT_CH_PASSWORD=change-me
FT_CH_DB=flowtrack
FT_BIND=0.0.0.0
FT_PORT=2055
FT_EXPORTERS=
FT_FORWARD=
FT_WEB_BIND=0.0.0.0
FT_WEB_PORT=3030
# HTTPS for the web UI (empty = plain HTTP). install.sh generates a self-signed pair here.
FT_TLS_CERT=/etc/flowtrack-v2/tls/cert.pem
FT_TLS_KEY=/etc/flowtrack-v2/tls/key.pem
