# FlowTrack configuration — copy to /etc/flowtrack.env and edit for your network.
# All values optional; defaults shown in comments match a typical small LAN setup.

# Bind address for collector (UDP) and web dashboard (TCP). 0.0.0.0 = all interfaces.
FLOWTRACK_BIND=0.0.0.0

# NetFlow UDP port the FortiGate exports to.
FLOWTRACK_PORT=2055

# Directory holding data.db (collector writes here).
FLOWTRACK_DATA_DIR=/opt/flowtrack

# SQLite path used by the web dashboard (must match DATA_DIR/data.db).
FLOWTRACK_DB=/opt/flowtrack/data.db

# Dashboard HTTP port. LAN-only — never publish via WAN.
FLOWTRACK_WEB_PORT=3020

# snmp-index of the WAN interface on FortiGate:  show system interface wan | grep snmp-index
FLOWTRACK_WAN_SNMP_INDEX=1

# Exporter (FortiGate) IPs allowed to send NetFlow, comma-separated — usually the
# FortiGate 'source-ip' from 'config system netflow'. Empty = accept from anyone.
FLOWTRACK_EXPORTERS=

# IANA time zone for day/month/hour buckets in the dashboard.
FLOWTRACK_TZ=Europe/Kyiv
