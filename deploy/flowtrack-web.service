[Unit]
Description=FlowTrack web dashboard (NetFlow usage)
After=network.target flowtrack.service

[Service]
EnvironmentFile=-/etc/flowtrack.env
ExecStart=/opt/flowtrack/venv/bin/python /opt/flowtrack/web.py
WorkingDirectory=/opt/flowtrack
Restart=always
RestartSec=3
User=flowtrack
Group=flowtrack
# hardening: unprivileged ports only, read-only system
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# SQLite WAL readers need write access to data.db-shm
ReadWritePaths=/opt/flowtrack

[Install]
WantedBy=multi-user.target
