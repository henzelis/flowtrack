[Unit]
Description=FlowTrack web UI + API
# (1.17.2) after the collector: it creates the tables the pages read (no «Unknown table» on the first start)
After=network-online.target docker.service flowtrack-collector.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/flowtrack/env
# the board UUID binds a license to this server; it is readable by root only ('+' runs this line as root)
# as root into a folder of the flowtrack user: never through a link left there (set -C: a new file only; mv -T)
ExecStartPre=+/bin/sh -c 'f=/var/lib/flowtrack/hw.board; rm -f "$$f.%N"; set -C; cat /sys/class/dmi/id/product_uuid > "$$f.%N" 2>/dev/null && mv -fT "$$f.%N" "$$f" || rm -f "$$f" "$$f.%N"'
ExecStart=/opt/flowtrack/venv/bin/python /opt/flowtrack/app/api.py
Restart=always
RestartSec=3
User=flowtrack
Group=flowtrack
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=flowtrack
StateDirectoryMode=0750
Environment=FT_STATE_DIR=/var/lib/flowtrack

[Install]
WantedBy=multi-user.target
