[Unit]
Description=FlowSphera backup check every 5 minutes (backup.py decides whether a scheduled backup is due)

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
# (2.0) the name before 2.0 answers too (systemctl status flowtrack-backup …) until 3.0
Alias=flowtrack-backup.timer
WantedBy=timers.target
