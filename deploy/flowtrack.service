[Unit]
Description=FlowTrack NetFlow v9 collector (FortiGate -> SQLite)
After=network.target

[Service]
EnvironmentFile=-/etc/flowtrack.env
ExecStart=/opt/flowtrack/venv/bin/python /opt/flowtrack/collector.py
WorkingDirectory=/opt/flowtrack
Restart=always
RestartSec=3
User=flowtrack
Group=flowtrack
# hardening: unprivileged ports only, read-only system
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/flowtrack

[Install]
WantedBy=multi-user.target
