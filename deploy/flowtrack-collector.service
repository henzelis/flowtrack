[Unit]
Description=FlowTrack collector (NetFlow/IPFIX -> ClickHouse)
After=network-online.target docker.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/flowtrack/env
ExecStart=/opt/flowtrack/venv/bin/python /opt/flowtrack/app/collector.py
Restart=always
RestartSec=3
User=flowtrack
Group=flowtrack
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=flowtrack
StateDirectoryMode=0750
Environment=FT_STATE_DIR=/var/lib/flowtrack

[Install]
WantedBy=multi-user.target
