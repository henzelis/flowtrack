[Unit]
Description=FlowSphera collector (NetFlow/IPFIX -> ClickHouse)
After=network-online.target docker.service
Wants=network-online.target

[Service]
# (1.17.2) started = the UDP sockets are open (collector.py sends READY=1); ClickHouse may take minutes after a boot
Type=notify
TimeoutStartSec=300
EnvironmentFile=/etc/flowtrack/env
# the board UUID binds a license to this server; it is readable by root only ('+' runs this line as root)
# as root into a folder of the flowtrack user: never through a link left there (set -C: a new file only; mv -T)
ExecStartPre=+/bin/sh -c 'f=/var/lib/flowtrack/hw.board; rm -f "$$f.%N"; set -C; cat /sys/class/dmi/id/product_uuid > "$$f.%N" 2>/dev/null && mv -fT "$$f.%N" "$$f" || rm -f "$$f" "$$f.%N"'
ExecStart=/opt/flowtrack/venv/bin/python /opt/flowtrack/app/collector.py
Restart=always
RestartSec=3
TimeoutStopSec=90
User=flowtrack
Group=flowtrack
NoNewPrivileges=yes
# (1.18.0) a port below 1024 (the web on 443, NetFlow / sFlow on a low port) needs this one capability: without it
# the service, which runs as flowtrack, failed with «Permission denied» and was restarted every 3 s for good
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=flowtrack
StateDirectoryMode=0750
Environment=FT_STATE_DIR=/var/lib/flowtrack

[Install]
WantedBy=multi-user.target
