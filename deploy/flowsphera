#!/bin/sh
# FlowSphera on this server (installed by install.sh as /usr/local/bin/flowsphera; /usr/local/bin/flowtrack is a synonym
# that says so, until 3.0):
#   flowsphera upgrade [--force] [--license FILE|CODE]   newest version from GitHub, settings and data kept
#   flowsphera status                                    version, services, edition
#   flowsphera license status|request|activate FILE|renew|deactivate
#   flowsphera reconfigure                               the installer's questions again (ports, device, password …)
#   flowsphera uninstall                                 remove FlowSphera (asks whether to keep the data)
#   flowsphera backup [now|list|verify|prune|copy] …     backups (backup.py); flowsphera restore [ID] [--from …] …
# FT_INSTALL_URL overrides where the installer comes from (testing).
REPO=telesphera/flowsphera
PREFIX=/opt/flowsphera
ETC=/etc/flowsphera
URL=${FT_INSTALL_URL:-https://raw.githubusercontent.com/$REPO/main/install.sh}
L=$(cat "$ETC/install-lang" 2>/dev/null || echo en)
t() { if [ "$L" = uk ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

usage() {
  if [ "$L" = uk ]; then cat <<'TXT'
FlowSphera на цьому сервері:
  sudo flowsphera upgrade [--force] [--license ФАЙЛ|КОД]  найновіша версія з GitHub; налаштування й дані зберігаються
  flowsphera status                                       версія, сервіси, редакція
  sudo flowsphera license status|request|activate ФАЙЛ|renew|deactivate
  sudo flowsphera reconfigure                             питання інсталятора ще раз (порти, пристрій, пароль …)
  sudo flowsphera uninstall                               видалити FlowSphera (спитає, чи зберегти дані)
  sudo flowsphera backup [--full]                         бекап зараз (даних і налаштувань; копії — як у «Налаштування → Бекапи»)
  sudo flowsphera backup list [--from s3|sftp|ftp|ТЕКА]   бекапи тут або на іншому місці
  sudo flowsphera backup verify [ID] [--deep]             перевірити бекап (--deep: відновити в тимчасову базу)
  sudo flowsphera restore [ID] [--from s3|sftp|ftp|ТЕКА] [--only-settings|--only-data] [--with-license] [--unencrypted]
TXT
  else cat <<'TXT'
FlowSphera on this server:
  sudo flowsphera upgrade [--force] [--license FILE|CODE]  newest version from GitHub; settings and data are kept
  flowsphera status                                       version, services, edition
  sudo flowsphera license status|request|activate FILE|renew|deactivate
  sudo flowsphera reconfigure                             the installer's questions again (ports, device, password …)
  sudo flowsphera uninstall                               remove FlowSphera (asks whether to keep the data)
  sudo flowsphera backup [--full]                         a backup now (data and settings; copies as in Settings → Backups)
  sudo flowsphera backup list [--from s3|sftp|ftp|DIR]    backups here or on another place
  sudo flowsphera backup verify [ID] [--deep]             check a backup (--deep: restore it into a scratch database)
  sudo flowsphera restore [ID] [--from s3|sftp|ftp|DIR] [--only-settings|--only-data] [--with-license] [--unencrypted]
TXT
  fi
}

root() { [ "$(id -u)" = 0 ] || exec sudo FT_INSTALL_URL="${FT_INSTALL_URL:-}" "$0" "$@"; }

# the installer, downloaded whole before it runs, with the language of this install
installer() {
  tmp=$(mktemp -d) || exit 1
  trap 'rm -rf "$tmp"' EXIT
  if ! curl -fsSL --retry 2 -o "$tmp/install.sh" "$URL?$(date +%s)"; then
    echo "$(t 'Could not download the installer from' 'Не вдалося завантажити інсталятор з') $URL" >&2; exit 1
  fi
  bash "$tmp/install.sh" --lang "$L" "$@"
}

version() { cat "$PREFIX/app/VERSION" 2>/dev/null || echo '?'; }

case "${1:-}" in
  upgrade)
    root "$@"; shift
    force=0; n=$#
    while [ "$n" -gt 0 ]; do                  # take --force out, keep the rest (a license file name may have spaces)
      a=$1; shift; n=$((n - 1))
      if [ "$a" = --force ]; then force=1; else set -- "$@" "$a"; fi
    done
    cur=$(version); new=$(curl -fsSL "${URL%/install.sh}/VERSION?$(date +%s)" 2>/dev/null | tr -d '[:space:]')
    if [ -n "$new" ] && [ "$new" = "$cur" ] && [ "$force" = 0 ] && [ $# = 0 ]; then
      echo "$(t "FlowSphera $cur is the latest version." "FlowSphera $cur — найновіша версія.") $(t '(flowsphera upgrade --force installs it again)' '(flowsphera upgrade --force встановить її ще раз)')"
      exit 0
    fi
    # never go back to an older version by accident (e.g. a build newer than the published one)
    if [ -n "$new" ] && [ "$new" != "$cur" ] && [ "$(printf '%s\n%s\n' "$new" "$cur" | sort -V | tail -1)" = "$cur" ] && [ "$force" = 0 ]; then
      echo "$(t "Installed FlowSphera $cur is newer than the published $new; nothing to do (--force installs $new)." "Встановлений FlowSphera $cur новіший за опублікований $new; нічого не роблю (--force встановить $new).")"
      exit 0
    fi
    [ -n "$new" ] && [ "$new" != "$cur" ] && echo "FlowSphera $cur → $new"
    installer --upgrade --yes "$@" ;;
  reconfigure) root "$@"; installer ;;
  uninstall) root "$@"; installer --uninstall ;;
  license) shift; exec /usr/local/bin/flowsphera-license "$@" ;;
  backup|restore) root "$@"; exec "$PREFIX/venv/bin/python" "$PREFIX/app/backup.py" "$@" ;;
  status)
    echo "FlowSphera $(version)"
    for u in flowsphera-collector flowsphera-web; do printf '  %-22s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null)"; done
    [ -x /usr/local/bin/flowsphera-license ] && /usr/local/bin/flowsphera-license status | sed 's/^/  /' ;;
  version|--version|-v) version ;;
  ''|help|-h|--help) usage ;;
  *) echo "$(t 'Unknown command:' 'Невідома команда:') $1" >&2; usage >&2; exit 2 ;;
esac
