[Unit]
Description=FlowSphera web UI + API
# (1.17.2) after the collector: it creates the tables the pages read (no «Unknown table» on the first start)
After=network-online.target docker.service flowsphera-collector.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/flowsphera/env
# the board UUID binds a license to this server; it is readable by root only ('+' runs this line as root)
# as root into a folder of the flowsphera user: never through a link left there (set -C: a new file only; mv -T)
ExecStartPre=+/bin/sh -c 'f=/var/lib/flowsphera/hw.board; rm -f "$$f.%N"; set -C; cat /sys/class/dmi/id/product_uuid > "$$f.%N" 2>/dev/null && mv -fT "$$f.%N" "$$f" || rm -f "$$f" "$$f.%N"'
ExecStart=/opt/flowsphera/venv/bin/python /opt/flowsphera/app/api.py
Restart=always
RestartSec=3
User=flowsphera
Group=flowsphera
NoNewPrivileges=yes
# (1.18.0) a port below 1024 (the web on 443, NetFlow / sFlow on a low port) needs this one capability: without it
# the service, which runs as flowsphera, failed with «Permission denied» and was restarted every 3 s for good
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=flowsphera
StateDirectoryMode=0750
Environment=FT_STATE_DIR=/var/lib/flowsphera

[Install]
# (2.0) the name before 2.0 answers too (systemctl status flowtrack-web …) until 3.0
Alias=flowtrack-web.service
WantedBy=multi-user.target
