[Unit]
Description=FlowTrack v2 collector (NetFlow/IPFIX -> ClickHouse)
After=network-online.target docker.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/flowtrack-v2/env
ExecStart=/opt/flowtrack-v2/venv/bin/python /opt/flowtrack-v2/app/collector.py
Restart=always
RestartSec=3
User=flowtrack
Group=flowtrack
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
